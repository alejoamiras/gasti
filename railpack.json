{
  "$schema": "https://schema.railpack.com",
  "steps": [
    {
      "name": "setup",
      "image": "node:24-alpine",
      "commands": ["npm install -g yarn ts-node typescript"]
    },
    {
      "name": "install",
      "commands": ["yarn install --production --frozen-lockfile"]
    }
  ],
  "deploy": {
    "base": "node:24-alpine",
    "startCommand": "exec node dist/bot.js",
    "inputs": ["setup", "install"],
    "restartPolicy": "always"
  }
}
