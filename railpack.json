{
  "$schema": "https://schema.railpack.com",
  "steps": [
    {
      "name": "setup",
      "image": "node:18",
      "commands": [
        "npm install -g yarn",
        "export NODE_OPTIONS='--max-old-space-size=384'"
      ]
    },
    {
      "name": "install",
      "commands": [
        "yarn install --production --frozen-lockfile"
      ]
    }
  ],
  "deploy": {
    "base": "node:18",
    "startCommand": "yarn start",
    "inputs": ["setup", "install"]
  }
} 